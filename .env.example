# Copy this file to .env and point it at your running FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# Stripe publishable key (starts with pk_test_ or pk_live_).
# Get it from your Stripe Dashboard -> Developers -> API keys.
# Required for real card payments (3D-Secure). Without it, the card
# payment form will show a setup message instead of the card field.
VITE_STRIPE_PUBLISHABLE_KEY=

# Full URL your FastAPI backend should redirect the customer to after a
# bKash checkout is approved/cancelled, e.g.
#   http://localhost:5173/payment-result
# This is only used by this README/for your reference when configuring
# the backend's bKash callback handler — the frontend route itself is
# fixed at /payment-result?payment_id=<id> (see src/pages/customer/PaymentResult.jsx).
